generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth.js tables ───────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Couple relationship
  coupleId      String?
  couple        Couple?   @relation(fields: [coupleId], references: [id])

  // Questionnaire profile
  values              String?   // JSON string
  aptitudes           String?   // JSON string
  background          String?   // JSON string
  questionnaireDone   Boolean   @default(false)

  // Unicorn space
  unicornTitle  String?
  unicornNotes  String?

  // Auth.js relations
  accounts      Account[]
  sessions      Session[]

  // Domain relations
  currentHoldings   CurrentHolding[]
  cardRatings       CardRating[]
  completionLogs    CompletionLog[]
  sentInvitations   Invitation[] @relation("InvitationSender")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ────────────────────────────────────────────
// Couple.phase state machine:
// INVITE → QUESTIONNAIRE → CURRENT_STATE → VALUATION → FINALIZE → STANDARDS → UNICORN → PLAYING
model Couple {
  id                String   @id @default(cuid())
  phase             String   @default("INVITE")
  hasKids           Boolean  @default(false)
  redealCadenceDays Int      @default(14)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members     User[]
  invitations Invitation[]
  coupleCards CoupleCard[]
  rounds      Round[]
}

model Invitation {
  id           String   @id @default(cuid())
  coupleId     String
  senderId     String
  inviteeEmail String
  token        String   @unique
  status       String   @default("PENDING")  // PENDING | ACCEPTED | REVOKED | EXPIRED
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  sender User   @relation("InvitationSender", fields: [senderId], references: [id])

  @@index([token])
  @@index([coupleId])
}

// Global immutable seed deck
model Card {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  description  String?
  suit         String  // HOME | OUT | CAREGIVING | MAGIC | WILD | UNICORN
  isKidRelated Boolean @default(false)
  isDailyGrind Boolean @default(false)
  defaultWeight Int    @default(3)  // 1–5

  coupleCards CoupleCard[]
}

// Per-couple card state
model CoupleCard {
  id              String   @id @default(cuid())
  coupleId        String
  cardId          String
  inDeck          Boolean  @default(true)
  currentHolderId String?  // assigned holder during PLAYING phase
  finalImportance String?  // DAILY_GRIND | IMPORTANT | VERY_IMPORTANT | UNICORN_WORTHY
  mscText         String?  // Minimum Standard of Care
  cpeText         String?  // Conception-Plan-Execution notes
  weightOverride  Int?     // overrides Card.defaultWeight for equity calc
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  couple          Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  card            Card            @relation(fields: [cardId], references: [id])
  currentHoldings CurrentHolding[]
  cardRatings     CardRating[]
  completionLogs  CompletionLog[]

  @@unique([coupleId, cardId])
  @@index([coupleId])
}

// Step-3 "who does this NOW" snapshot — both partners can mark same card
model CurrentHolding {
  id           String   @id @default(cuid())
  coupleCardId String
  userId       String
  createdAt    DateTime @default(now())

  coupleCard CoupleCard @relation(fields: [coupleCardId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coupleCardId, userId])
}

// Per-partner importance rating
model CardRating {
  id           String   @id @default(cuid())
  coupleCardId String
  userId       String
  rating       String   // DAILY_GRIND | IMPORTANT | VERY_IMPORTANT | UNICORN_WORTHY
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coupleCard CoupleCard @relation(fields: [coupleCardId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coupleCardId, userId])
}

// Re-deal cycles
model Round {
  id        String   @id @default(cuid())
  coupleId  String
  index     Int      // 1-based
  startedAt DateTime @default(now())
  createdAt DateTime @default(now())

  couple         Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  completionLogs CompletionLog[]

  @@unique([coupleId, index])
  @@index([coupleId])
}

// Card completions per round per user
model CompletionLog {
  id           String   @id @default(cuid())
  coupleCardId String
  userId       String
  roundId      String
  completedAt  DateTime @default(now())

  coupleCard CoupleCard @relation(fields: [coupleCardId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  round      Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([coupleCardId])
  @@index([userId])
  @@index([roundId])
}
